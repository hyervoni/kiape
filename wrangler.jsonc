{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiape",
  "account_id": "f2891eef65ceaeb04a8f2669696ed9d0",
  "compatibility_date": "2026-11-16",
  // Tiny worker: redirects the apex to www, everything else is the static Astro build in dist/.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "www.kiape.co", "custom_domain": true },
    { "pattern": "kiape.co", "custom_domain": true }
  ]
}
