---
/**
 * Instagram band: static grid linking to the profile.
 * Deliberately not the official embed (heavy, third-party cookies).
 * TODO(kiape): replace the images with 6 real posts exported from @kiape.suelos.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../config';
import Icon from './Icon.astro';

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/img/*.jpg', { eager: true });
const posts = [
  { name: 'cocina-roble', alt: 'cocina con tarima de roble' },
  { name: 'tarima-espiga', alt: 'roble en espiga' },
  { name: 'villa-piscina', alt: 'porcelánico junto a la piscina' },
  { name: 'porcelanico-bano', alt: 'baño en porcelánico' },
  { name: 'laminado-salon', alt: 'laminado en espiga' },
  { name: 'interior-luz', alt: 'interior con porcelánico claro' },
].map((p) => ({ ...p, src: images[`../assets/img/${p.name}.jpg`].default }));
---

{
  site.instagram && (
    <section class="ig" aria-labelledby="ig-title">
      <div class="wrap ig__head">
        <div>
          <p class="eyebrow ig__eyebrow" data-reveal>Obra a obra</p>
          <h2 id="ig-title" class="h2" data-reveal>
            Síguenos en <em>{site.instagramHandle}</em>
          </h2>
        </div>
        <a href={site.instagram} class="btn btn--ghost" target="_blank" rel="noopener" data-track="instagram_click" data-reveal>
          <Icon name="instagram" /> Ver Instagram
        </a>
      </div>
      <ul class="ig__grid" role="list">
        {posts.map((p, i) => (
          <li data-reveal style={`--d:${i * 60}ms`}>
            <a href={site.instagram} target="_blank" rel="noopener" aria-label={`Ver en Instagram: ${p.alt}`} data-track="instagram_click">
              <Picture src={p.src} alt="" formats={['avif', 'webp']} widths={[240, 400, 600]} sizes="(min-width: 900px) 16vw, 33vw" />
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .ig {
    background: var(--paper);
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
  }

  .ig__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .ig__eyebrow {
    color: var(--oak);
    margin-bottom: 0.75rem;
  }

  .ig__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3px;
  }

  .ig__grid a {
    display: block;
    overflow: hidden;
  }

  .ig__grid :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    transition:
      transform 1s var(--ease),
      opacity 0.4s var(--ease);
  }

  .ig__grid a:hover :global(img) {
    transform: scale(1.05);
    opacity: 0.85;
  }

  @media (min-width: 900px) {
    .ig__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 8px;
      padding-inline: 8px;
    }
  }
</style>
