---
import { waLink } from '../config';
import Icon from './Icon.astro';
---

<div class="mcta" data-mcta>
  <a class="mcta__wa" href={waLink()} target="_blank" rel="noopener" data-track="whatsapp_click">
    <Icon name="whatsapp" />WhatsApp
  </a>
  <a class="mcta__main" href="/#contacto">Solicitar visita</a>
</div>

<style>
  .mcta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--ink);
    transform: translateY(110%);
    transition: transform 0.5s var(--ease);
  }

  :global(html[data-scrolled]) .mcta {
    transform: none;
  }

  :global(html[data-at-contact]) .mcta {
    transform: translateY(110%);
  }

  .mcta a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 58px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .mcta :global(svg) {
    width: 20px;
    height: 20px;
  }

  .mcta__wa {
    color: var(--paper);
    border-right: 1px solid rgb(250 247 242 / 0.15);
  }

  .mcta__main {
    background: var(--oak);
    color: var(--paper);
  }

  @media (min-width: 760px) {
    .mcta {
      display: none;
    }
  }
</style>
