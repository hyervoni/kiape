---
import '../styles/global.css';
import { site, path, isPreview } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import CookieConsent from '../components/CookieConsent.astro';
// Preload the latin subsets used above the fold to avoid font-swap layout shift.
import serifFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import serifItalicFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import sansFont from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Extra JSON-LD objects (e.g. FAQPage) */
  schema?: Record<string, unknown>[];
  /** Header starts transparent over a full-bleed hero */
  overlayHeader?: boolean;
}

const {
  title = site.title,
  description = site.description,
  noindex = false,
  schema = [],
  overlayHeader = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '') || site.url;
const ogImage = new URL(path('/og.jpg'), Astro.site).href;
const robots = noindex || isPreview ? 'noindex, follow' : undefined;

const business = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${site.url}/#business`,
  name: site.name,
  description: site.description,
  url: site.url,
  image: ogImage,
  logo: new URL(path('/favicon.svg'), Astro.site).href,
  telephone: site.phone,
  email: site.email,
  priceRange: '€€€',
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Illes Balears',
    addressLocality: 'Mallorca',
    addressCountry: 'ES',
  },
  areaServed: { '@type': 'AdministrativeArea', name: 'Mallorca' },
  knowsAbout: ['Instalación de tarima', 'Parquet en espiga', 'Porcelánico de gran formato', 'Suelo vinílico', 'Suelo laminado'],
  sameAs: [site.instagram, site.facebook].filter(Boolean),
};

const jsonLd = [business, ...schema];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {[sansFont, serifFont, serifItalicFont].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#1b1915" />
    <link rel="icon" type="image/svg+xml" href={path('/favicon.svg')} />
    <link rel="icon" href={path('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={path('/apple-touch-icon.png')} />
    <link rel="sitemap" href={path('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Interior con suelo de roble instalado por KIAPE en Mallorca" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="geo.region" content="ES-IB" />
    <meta name="geo.placename" content="Mallorca" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileCta />
    <CookieConsent />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
